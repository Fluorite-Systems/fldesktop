from PySide6.QtWidgets import QWidget, QGraphicsBlurEffect, QGraphicsScene, QGraphicsPixmapItem, QVBoxLayout
from PySide6.QtGui import QPainter, QPixmap, QColor, QResizeEvent, QMoveEvent
from PySide6.QtCore import QTimer, QRect, Qt, QPoint, QRectF


class Glass(QWidget):
    """Стеклянный оверлей с размытием (QWidget)"""

    def __init__(self, parent=None, border=True):
        super().__init__(parent)
        
        self.blur_radius = 8
        self.opacity = 1
        self.enable_border = border
        self._blurred = None
        self._updating = False
        self._timer = QTimer()
        self._timer.setSingleShot(True)
        self._timer.timeout.connect(self._update_background)
        
        # Настройка прозрачности
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setAttribute(Qt.WidgetAttribute.WA_OpaquePaintEvent, False)
        
        # Контейнер для внутренних виджетов
        self._container = QWidget(self)
        self._container.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        layout = QVBoxLayout(self._container)
        layout.setContentsMargins(15, 15, 15, 15)
        self._container.setLayout(layout)
        
        # Обновляем фон при изменениях
        self._schedule_update()
        
    def layout(self):
        """Возвращает layout для добавления виджетов"""
        return self._container.layout()
        
    def _schedule_update(self):
        """Планирует обновление фона"""
        if not self._updating and self.isVisible():
            self._timer.start(5)
            
    def _update_background(self):
        """Обновляет размытый фон"""
        if self._updating or not self.isVisible() or not self.parent():
            return
            
        self._updating = True
        
        try:
            # Получаем позицию и размер
            global_rect = QRect(self.mapToGlobal(QPoint(0, 0)), self.size())
            
            # Временно скрываем себя для захвата
            was_visible = self.isVisible()
            if was_visible:
                self.hide()
                self.parent().update()
            
            # Захватываем родителя
            parent_pixmap = self.parent().grab()
            
            # Возвращаем видимость
            if was_visible:
                self.show()
                
            if parent_pixmap.isNull():
                return
                
            # Вырезаем область под виджетом
            pos = self.pos()
            x = max(0, pos.x())
            y = max(0, pos.y())
            w = min(self.width(), parent_pixmap.width() - x)
            h = min(self.height(), parent_pixmap.height() - y)
            
            if w > 0 and h > 0:
                cropped = parent_pixmap.copy(x, y, w, h)
                if not cropped.isNull():
                    self._blurred = self._apply_blur(cropped)
                    
        except Exception:
            self._blurred = None
            
        finally:
            self._updating = False
            self.update()
            
    def _apply_blur(self, pixmap):
        """Применяет размытие"""
        if pixmap.isNull():
            return pixmap
            
        scene = QGraphicsScene()
        item = QGraphicsPixmapItem(pixmap)
        scene.addItem(item)
        
        blur = QGraphicsBlurEffect()
        blur.setBlurRadius(self.blur_radius)
        blur.setBlurHints(QGraphicsBlurEffect.BlurHint.PerformanceHint)
        item.setGraphicsEffect(blur)
        
        result = QPixmap(pixmap.size())
        result.fill(Qt.GlobalColor.transparent)
        
        painter = QPainter(result)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        scene.render(painter, QRectF(result.rect()), QRectF(pixmap.rect()))
        painter.end()
        
        return result
        
    def paintEvent(self, event):
        """Отрисовка оверлея"""
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        
        if self._blurred and not self._blurred.isNull():
            painter.setOpacity(self.opacity)
            painter.drawPixmap(0, 0, self._blurred)
            painter.setOpacity(1.0)
        else:
            painter.fillRect(self.rect(), QColor(0, 0, 0, 100))
            
        # Полупрозрачный слой для читаемости
        painter.setPen(QColor(30, 30, 30, 30))
        if self.enable_border:
            painter.drawRoundedRect(self.rect(), 14, 14)
        else:
            painter.drawRect(self.rect())
        
        # Рисуем рамку
        if self.enable_border:
            painter.setPen(QColor(255, 255, 255, 80))
            painter.setBrush(Qt.BrushStyle.NoBrush)
            painter.drawRoundedRect(self.rect().adjusted(1, 1, -1, -1), 10, 10)
        
        super().paintEvent(event)
        
    def resizeEvent(self, event: QResizeEvent):
        """При изменении размера"""
        super().resizeEvent(event)
        self._container.setGeometry(self.rect())
        self._schedule_update()
        
    def moveEvent(self, event: QMoveEvent):
        """При перемещении"""
        super().moveEvent(event)
        self._schedule_update()
        
    def showEvent(self, event):
        """При показе"""
        super().showEvent(event)
        self._schedule_update()